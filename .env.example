# Supabase is the application's only data backend.
# Existing Vercel projects may use NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional server-side key for the informational assistant and forecast explanations.
GEMINI_API_KEY="your-server-side-gemini-api-key"
